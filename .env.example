# Base de datos
DATABASE_URL="postgresql://usuario:clave@host:5432/pudu"

# Acceso administrativo
# Usa una clave única y un secreto aleatorio de al menos 32 caracteres.
ADMIN_PASSWORD="cambia-esta-clave"
ADMIN_SESSION_SECRET="genera-un-secreto-aleatorio-de-al-menos-32-caracteres"

# Actívalo solamente para revisar el pipeline sin una base de datos.
CRM_DEMO_MODE="false"

# Correo saliente
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
