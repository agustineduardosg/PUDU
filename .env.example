# Base de datos
DATABASE_URL="postgresql://usuario:clave@host:5432/pudu"

# Acceso administrativo
# Usa una clave única y un secreto aleatorio de al menos 32 caracteres.
ADMIN_PASSWORD="cambia-esta-clave"
ADMIN_SESSION_SECRET="genera-un-secreto-aleatorio-de-al-menos-32-caracteres"

# Actívalo solamente para revisar el pipeline sin una base de datos.
CRM_DEMO_MODE="false"

# Correo saliente
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PUDU IT Solutions <contacto@pudu.cl>"

# Seguridad de envíos CRM
# El envío real solo se habilita con esta variable en "true".
CRM_EMAIL_SENDING_ENABLED="false"
CRM_EMAIL_DAILY_LIMIT="20"
# Usa "preview" solamente en local; "smtp" entrega al proveedor real.
CRM_EMAIL_DELIVERY_MODE="smtp"
